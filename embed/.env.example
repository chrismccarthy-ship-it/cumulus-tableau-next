# External Client App (Tableau Next → Administration → External Client App): web server flow + PKCE
SF_CLIENT_ID=<consumer key>
SF_CLIENT_SECRET=            # only if "Require Secret for Web Server Flow" is enabled on the ECA
SF_LOGIN_URL=https://login.salesforce.com   # or https://<mydomain>.my.salesforce.com
SF_ORG_URL=https://<mydomain>.lightning.force.com   # MUST be the Lightning URL, not my.salesforce.com
SF_REDIRECT_URI=http://localhost:3000/getAccessToken   # add this as a Callback URL on the ECA
PORT=3000
SESSION_SECRET=change-me

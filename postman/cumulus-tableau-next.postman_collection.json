        {
          "name": "Semantic query \u2014 cases by channel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{instanceUrl}}/services/data/v{{apiVersion}}/semantic-engine/gateway",
              "host": [
                "{{instanceUrl}}"
              ],
              "path": [
                "services",
                "data",
                "v{{apiVersion}}",
                "semantic-engine",
                "gateway"
              ]
            },
            "description": "Same query shape the LWC Dashboard Extension SDK uses in fetchDataUsingQueryAndSource().",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"semanticModelApiName\": \"{{sdmApiName}}\",\n  \"structuredSemanticQuery\": {\n    \"fields\": [\n      {\n        \"expression\": {\n          \"tableField\": {\n            \"tableName\": \"rb_service_cases\",\n            \"name\": \"Channel\"\n          }\n        },\n        \"alias\": \"Channel\",\n        \"rowGrouping\": true\n      },\n      {\n        \"expression\": {\n          \"tableField\": {\n            \"tableName\": \"rb_service_cases\",\n            \"name\": \"CaseId\"\n          }\n        },\n        \"alias\": \"Cases\",\n        \"semanticAggregationMethod\": \"SEMANTIC_AGGREGATION_METHOD_UNIQUE_COUNT\"\n      }\n    ],\n    \"options\": {\n      \"limit_options\": {\n        \"limit\": 100\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Semantic query \u2014 filtered (dispute cases since May 2026)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{instanceUrl}}/services/data/v{{apiVersion}}/semantic-engine/gateway",
              "host": [
                "{{instanceUrl}}"
              ],
              "path": [
                "services",
                "data",
                "v{{apiVersion}}",
                "semantic-engine",
                "gateway"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"semanticModelApiName\": \"{{sdmApiName}}\",\n  \"structuredSemanticQuery\": {\n    \"fields\": [\n      {\n        \"expression\": {\n          \"tableField\": {\n            \"tableName\": \"rb_service_cases\",\n            \"name\": \"BranchId\"\n          }\n        },\n        \"alias\": \"Branch\",\n        \"rowGrouping\": true\n      },\n      {\n        \"expression\": {\n          \"tableField\": {\n            \"tableName\": \"rb_service_cases\",\n            \"name\": \"CaseId\"\n          }\n        },\n        \"alias\": \"Cases\",\n        \"semanticAggregationMethod\": \"SEMANTIC_AGGREGATION_METHOD_UNIQUE_COUNT\"\n      }\n    ],\n    \"filter\": {\n      \"filters\": [\n        {\n          \"fieldName\": \"rb_service_cases.CaseType\",\n          \"operator\": \"Equals\",\n          \"values\": [\n            \"Card Dispute\"\n          ]\n        },\n        {\n          \"fieldName\": \"rb_service_cases.CreatedDate\",\n          \"operator\": \"GreaterThanOrEqualTo\",\n          \"values\": [\n            \"2026-05-01\"\n          ]\n        }\n      ],\n      \"filterLogic\": \"1 AND 2\"\n    },\n    \"options\": {\n      \"limit_options\": {\n        \"limit\": 100\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },

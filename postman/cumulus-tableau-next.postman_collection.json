    {
      "name": "4 \u00b7 Tableau Next MCP (hosted)",
      "description": "Postman MCP request type: URL https://api.salesforce.com/platform/mcp/v1/analytics/tableau-next, transport Streamable HTTP, OAuth 2.0 with PKCE, Client ID = ECA consumer key. Example tool calls below are JSON-RPC bodies for reference.",
      "item": [
        {
          "name": "initialize",
          "request": {
            "method": "POST",
            "header": [

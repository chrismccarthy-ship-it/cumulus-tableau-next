            ],
            "url": {
              "raw": "https://api.salesforce.com/platform/mcp/v1/analytics/tableau-next",
              "protocol": "https",
              "host": [
                "api",
                "salesforce",
                "com"
              ],
              "path": [
                "platform",
                "mcp",
                "v1",
                "analytics",
                "tableau-next"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"initialize\",\n  \"params\": {\n    \"protocolVersion\": \"2025-06-18\",\n    \"capabilities\": {},\n    \"clientInfo\": {\n      \"name\": \"postman\",\n      \"version\": \"1.0\"\n    }\n  }\n}",
              "options": {

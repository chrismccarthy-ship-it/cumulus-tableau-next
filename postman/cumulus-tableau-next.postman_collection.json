{
  "info": {
    "name": "Cumulus \u2014 Tableau Next APIs",
    "description": "Tableau Next REST API, Tableau Semantics Query API, App Framework Connect API and the hosted MCP server. Set collection variables instanceUrl (My Domain, https://xxx.my.salesforce.com), apiVersion (67.0), accessToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "instanceUrl",
      "value": "https://YOUR-DOMAIN.my.salesforce.com"
    },
    {
      "key": "apiVersion",
      "value": "67.0"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "sdmApiName",
      "value": "Cumulus_Retail_Banking_SDM"
    },
    {
      "key": "loginUrl",
      "value": "https://login.salesforce.com"
    }
  ],
  "item": [
    {
      "name": "0 \u00b7 Auth",
      "item": [
        {
          "name": "OAuth 2.0 token (client credentials via ECA)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{loginUrl}}/services/oauth2/token",
              "host": [
                "{{loginUrl}}"
              ],
              "path": [
                "services",
                "oauth2",
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{clientSecret}}"
                }
              ]
            },
            "description": "Simplest for demos: an External Client App with the Client Credentials flow enabled and a run-as user that has Tableau Next Admin + Data Cloud Architect. Copy access_token into the accessToken variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json(); if (j.access_token) { pm.collectionVariables.set('accessToken', j.access_token); pm.collectionVariables.set('instanceUrl', j.instance_url); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Frontdoor URL for Embedding SDK",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{instanceUrl}}/services/oauth2/singleaccess",
              "host": [
                "{{instanceUrl}}"
              ],
              "path": [
                "services",
                "oauth2",
                "singleaccess"
              ]
            },
            "description": "POST with the bearer token; response.frontdoor_uri is the authCredential for initializeAnalyticsSdk().",
            "body": {
              "mode": "raw",
              "raw": "",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            }
          }
        }
      ]
    },

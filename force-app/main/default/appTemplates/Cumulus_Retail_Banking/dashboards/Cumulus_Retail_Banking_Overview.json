    "x_banner": {
      "actions": [],
      "name": "x_banner",
      "label": "cumulusThresholdBanner",
      "parameters": {
        "fullyQualifiedName": "c:cumulusThresholdBanner",
        "properties": {
          "measureField": {
            "name": "Avg_CSAT",
            "aggregation": "UserAgg",
            "label": "Avg CSAT"
          },
          "threshold": "3.5",
          "belowIsBad": true,
          "alertMessage": "CSAT below the 3.5 target \u2014 Card Dispute cases score lowest",
          "okMessage": "CSAT at or above target",
          "format": "number",
          "focusDimension": {
            "name": "RB_Service_Cases.CaseType",
            "label": "Case Type"
          },
          "focusValue": "Card Dispute",
          "sdmName": {

{
  "name": "Cumulus_Retail_RVP_Console",
  "label": "Cumulus Retail RVP Console ${Variables.LabelSuffix}",
  "description": "Cumulus Retail RVP Console \u2014 full-page console extension with AI-driven insights and actions.",
  "customConfig": {
    "queryCacheEnabled": true,
    "queryCacheStaleness": "30min"
  },
  "layouts": [
    {
      "columnCount": 96,
      "maxWidth": 1800,
      "name": "default",
      "pages": [
        {
          "label": "Console",
          "name": "console",
          "widgets": [
            {
              "name": "console",
              "column": 0,
              "row": 0,
              "colspan": 96,
              "rowspan": 150
            }
          ]
        }
      ],
      "rowHeight": 10,
      "style": {
        "backgroundColor": "#F5F7FA",
        "cellSpacingX": 0,
        "cellSpacingY": 0,
        "gutterColor": "#F5F7FA"
      }
    }
  ],
  "style": {
    "widgetStyle": {
      "backgroundColor": "#F5F7FA",
      "borderColor": "#F5F7FA",
      "borderEdges": [],
      "borderRadius": 16,
      "borderWidth": 0
    }
  },
  "widgets": {
    "console": {
      "actions": [],
      "name": "console",
      "label": "cumulusRetailConsole",
      "parameters": {
        "fullyQualifiedName": "c:cumulusRetailConsole",
        "properties": {
          "title": "RVP \u2013 Retail Sales Performance",
          "accentColor": "#0F766E",
          "sdmName": {
            "apiName": "${App.SemanticModels.Cumulus_Retail_Banking_SDM.Name}",
            "id": "${App.SemanticModels.Cumulus_Retail_Banking_SDM.Id}",
            "label": "Cumulus Retail Banking Model"
          }
        },
        "widgetStyle": {
          "backgroundColor": "#F5F7FA",
          "borderColor": "#F5F7FA",
          "borderEdges": [],
          "borderRadius": 16,
          "borderWidth": 0
        }
      },
      "source": {
        "name": "c:cumulusRetailConsole",
        "namespace": "c",
        "type": "LightningWebComponent"
      },
      "type": "extension"
    }
  },
  "workspaceIdOrApiName": "${App.Workspaces.Cumulus_Retail_Banking_WS.Name}"
}
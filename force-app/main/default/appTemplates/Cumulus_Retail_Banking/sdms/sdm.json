      "decimalPlace": 2,
      "directionality": "Up",
      "displayCategory": "Continuous",
      "expression": "COUNT(IF [RB_Service_Cases].[CaseType] = 'Card Dispute' THEN [RB_Service_Cases].[CaseId] END)",

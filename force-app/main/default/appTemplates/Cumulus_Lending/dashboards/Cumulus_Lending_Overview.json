    "hdr": {
      "actions": [],
      "name": "hdr",
      "type": "text",
      "parameters": {
        "conditionalFormattingRules": [],
        "receiveFilterSource": {
          "filterMode": "all",
          "widgetIds": []
        },
        "content": [
          {
            "attributes": {
              "color": "#032D60",
              "size": "22px",
              "bold": true
            },
            "insert": "Cumulus Lending Overview",
            "rules": []
          },
          {
            "attributes": {
              "align": "left"
            },
            "insert": "\n",
            "rules": []
          },
          {
            "attributes": {
              "color": "#5C6B82",
              "size": "13px"
            },
            "insert": "",
            "rules": []
          },
          {
            "attributes": {
              "align": "left"
            },
            "insert": "\n",
            "rules": []
          }
        ]
      }
    },
    "x_banner": {
      "actions": [],
      "name": "x_banner",
      "label": "cumulusThresholdBanner",
      "parameters": {
        "fullyQualifiedName": "c:cumulusThresholdBanner",
        "properties": {
          "measureField": {
            "name": "Avg_Time_To_Close",
            "aggregation": "UserAgg",
            "label": "Avg Time to Close"
          },
          "threshold": "30",
          "alertMessage": "Time to close above 30 days \u2014 document collection is the bottleneck",
          "okMessage": "Time to close within target",
          "format": "number",
          "focusDimension": {
            "name": "LN_Applications.Channel",
            "label": "Channel"
          },
          "focusValue": "Branch",
          "sdmName": {
            "apiName": "${App.SemanticModels.Cumulus_Lending_SDM.Name}",
            "id": "${App.SemanticModels.Cumulus_Lending_SDM.Id}",
            "label": "Cumulus Lending Model"
          }
        },
        "widgetStyle": {
          "backgroundColor": "#FFFFFF",
          "borderColor": "#E5E5E5",
          "borderEdges": [],
          "borderRadius": 8,
          "borderWidth": 1
        }
      },
      "source": {
        "name": "c:cumulusThresholdBanner",
        "namespace": "c",
        "type": "LightningWebComponent"
      },
      "type": "extension"
    },

    "x_banner": {
      "actions": [],
      "name": "x_banner",
      "label": "cumulusThresholdBanner",
      "parameters": {
        "fullyQualifiedName": "c:cumulusThresholdBanner",
        "properties": {
          "measureField": {
            "name": "Loss_Ratio",
            "aggregation": "UserAgg",
            "label": "Loss Ratio"
          },
          "threshold": "0.6",
          "alertMessage": "Loss ratio above 60% \u2014 review pricing and claims handling",

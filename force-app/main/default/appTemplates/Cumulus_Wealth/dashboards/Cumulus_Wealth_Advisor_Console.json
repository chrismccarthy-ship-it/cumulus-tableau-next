{
  "name": "Cumulus_Wealth_Advisor_Console",
  "label": "Cumulus Wealth Advisor Console ${Variables.LabelSuffix}",
  "description": "Cumulus Wealth Advisor Console \u2014 full-page console extension with AI-driven insights and actions.",
  "customConfig": {
    "queryCacheEnabled": true,
    "queryCacheStaleness": "30min"
  },
  "layouts": [
    {
      "columnCount": 96,
      "maxWidth": 1800,
      "name": "default",
      "pages": [
        {
          "label": "Console",
          "name": "console",
          "widgets": [
            {
              "name": "console",
              "column": 0,
              "row": 0,
              "colspan": 96,
              "rowspan": 150
            }
          ]
        }
      ],
      "rowHeight": 10,
      "style": {
        "backgroundColor": "#EEF2FF",
        "cellSpacingX": 0,
        "cellSpacingY": 0,
        "gutterColor": "#EEF2FF"
      }
    }
  ],
  "style": {
    "widgetStyle": {
      "backgroundColor": "#EEF2FF",
      "borderColor": "#EEF2FF",
      "borderEdges": [],
      "borderRadius": 16,
      "borderWidth": 0
    }
  },
  "widgets": {
    "console": {
      "actions": [],
      "name": "console",
      "label": "cumulusWealthConsole",
      "parameters": {
        "fullyQualifiedName": "c:cumulusWealthConsole",
        "properties": {
          "title": "Wealth Performance",
          "accentColor": "#1D4ED8",
          "sdmName": {
            "apiName": "${App.SemanticModels.Cumulus_Wealth_SDM.Name}",
            "id": "${App.SemanticModels.Cumulus_Wealth_SDM.Id}",
            "label": "Cumulus Wealth Model"
          }
        },
        "widgetStyle": {
          "backgroundColor": "#EEF2FF",
          "borderColor": "#EEF2FF",
          "borderEdges": [],
          "borderRadius": 16,
          "borderWidth": 0
        }
      },
      "source": {
        "name": "c:cumulusWealthConsole",
        "namespace": "c",
        "type": "LightningWebComponent"
      },
      "type": "extension"
    }
  },
  "workspaceIdOrApiName": "${App.Workspaces.Cumulus_Wealth_WS.Name}"
}